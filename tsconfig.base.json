{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@teledrive/contracts": ["packages/contracts/src/index.ts"],
      "@teledrive/upload-engine": ["packages/upload-engine/src/index.ts"],
      "@teledrive/crypto": ["packages/crypto/src/index.ts"],
      "@teledrive/telegram": ["packages/telegram/src/index.ts"]
    }
  }
}
